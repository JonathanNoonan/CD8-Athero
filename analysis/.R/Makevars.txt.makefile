# Use macOS native clang for this project only
CC=/Library/Developer/CommandLineTools/usr/bin/clang
CXX=/Library/Developer/CommandLineTools/usr/bin/clang++
CXX11=/Library/Developer/CommandLineTools/usr/bin/clang++
CXX14=/Library/Developer/CommandLineTools/usr/bin/clang++
CXX17=/Library/Developer/CommandLineTools/usr/bin/clang++
CXX20=/Library/Developer/CommandLineTools/usr/bin/clang++
CXXFLAGS=-std=c++17 -Wall -g -O2

